local AutoCollectActive = false
local CollectLoop = nil


local function GetMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    local searchName = player.Name .. "_FloatingPlotSign"
    
    for _, plot in pairs(plots:GetChildren()) do
        
        local sign = plot:FindFirstChild(searchName)
        if sign then
            return plot
        end
        
        
        local nested = plot:FindFirstChild(plot.Name)
        if nested then
            sign = nested:FindFirstChild(searchName)
            if sign then
                return nested
            end
        end
    end
    return nil
end


CreateToggle(AlinurTab, "AUTO COLLECT", function(active)
    AutoCollectActive = active
    
    if active then
        CollectLoop = task.spawn(function()
            while AutoCollectActive do
                local char = player.Character
                if not char then
                    task.wait(0.5)
                    continue
                end
                
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then
                    task.wait(0.5)
                    continue
                end
                
                
                local myPlot = GetMyPlot()
                if not myPlot then
                    task.wait(2)
                    continue
                end
                
                local containers = myPlot:FindFirstChild("Containers")
                if not containers then
                    task.wait(2)
                    continue
                end
                
                
                for i = 1, 30 do
                    if not AutoCollectActive then break end
                    
                    local container = containers:FindFirstChild(tostring(i))
                    if container then
                        local subContainer = container:FindFirstChild(tostring(i))
                        if subContainer then
                            local collectVFX = subContainer:FindFirstChild("CollectVFX")
                            if collectVFX then
                                
                                local targetPos = nil
                                
                                if collectVFX:IsA("BasePart") then
                                    targetPos = collectVFX.Position + Vector3.new(0, 5, 0)
                                elseif collectVFX:IsA("Attachment") then
                                    targetPos = collectVFX.WorldPosition + Vector3.new(0, 5, 0)
                                elseif collectVFX:IsA("Model") and collectVFX.PrimaryPart then
                                    targetPos = collectVFX.PrimaryPart.Position + Vector3.new(0, 5, 0)
                                end
                                
                                if targetPos then
                                    
                                    pcall(function()
                                        
                                        root.CFrame = CFrame.new(targetPos)
                                    end)
                                    
                                    pcall(function()
                                        
                                        local humanoid = char:FindFirstChild("Humanoid")
                                        if humanoid then
                                            humanoid:MoveTo(targetPos)
                                        end
                                    end)
                                    
                                    pcall(function()
                                        
                                        char:PivotTo(CFrame.new(targetPos))
                                    end)
                                    
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
                
                task.wait(0.3)
            end
        end)
    else
        CollectLoop = nil
    end
end)


