ManualCollectBtn.MouseButton1Click:Connect(function()
    local char = player.Character
    if not char then
        ManualCollectBtn.Text = "NO CHARACTER!"
        task.wait(1)
        ManualCollectBtn.Text = "COLLECT NOW (تجميع يدوي)"
        return
    end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        ManualCollectBtn.Text = "NO HRP!"
        task.wait(1)
        ManualCollectBtn.Text = "COLLECT NOW (تجميع يدوي)"
        return
    end
    
    local myPlot = GetMyPlot()
    if not myPlot then
        ManualCollectBtn.Text = "PLOT NOT FOUND!"
        task.wait(1)
        ManualCollectBtn.Text = "COLLECT NOW (تجميع يدوي)"
        return
    end
    
    ManualCollectBtn.Text = "PLOT: " .. myPlot.Name
    task.wait(0.5)
    
    local containers = myPlot:FindFirstChild("Containers")
    if not containers then
        ManualCollectBtn.Text = "NO CONTAINERS!"
        task.wait(1)
        ManualCollectBtn.Text = "COLLECT NOW (تجميع يدوي)"
        return
    end
    
    
    local count = 0
    local errors = 0
    
    for i = 1, 30 do
        local container = containers:FindFirstChild(tostring(i))
        if container then
            local subContainer = container:FindFirstChild(tostring(i))
            if subContainer then
                local collectVFX = subContainer:FindFirstChild("CollectVFX")
                if collectVFX then
                    local targetPos = nil
                    local vfxType = collectVFX.ClassName
                    
                    if collectVFX:IsA("BasePart") then
                        targetPos = collectVFX.Position + Vector3.new(0, 5, 0)
                    elseif collectVFX:IsA("Attachment") then
                        targetPos = collectVFX.WorldPosition + Vector3.new(0, 5, 0)
                    elseif collectVFX:IsA("Model") and collectVFX.PrimaryPart then
                        targetPos = collectVFX.PrimaryPart.Position + Vector3.new(0, 5, 0)
                    end
                    
                    if targetPos then
                        local success = pcall(function()
                            root.CFrame = CFrame.new(targetPos)
                        end)
                        
                        if success then
                            count = count + 1
                            ManualCollectBtn.Text = "TP TO: " .. i .. " (" .. vfxType .. ")"
                        else
                            errors = errors + 1
                        end
                        
                        task.wait(0.15)
                    else
                        ManualCollectBtn.Text = "NO POS: " .. i .. " (" .. vfxType .. ")"
                        task.wait(0.5)
                    end
                end
            end
        end
    end
    
    ManualCollectBtn.Text = "DONE: " .. count .. " OK, " .. errors .. " ERR"
    TweenService:Create(ManualCollectBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Success}):Play()
    task.wait(2)
    ManualCollectBtn.Text = "COLLECT NOW (Debug)"
    TweenService:Create(ManualCollectBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.SurfaceLight}):Play()
end)






